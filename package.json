{
  "name": "zotero-snowball-sources",
  "version": "0.6.0",
  "private": true,
  "description": "Zotero plugin for OpenAlex forward and backward citation snowballing.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/socratic-irony/zotero-snowball.git"
  },
  "bugs": {
    "url": "https://github.com/socratic-irony/zotero-snowball/issues"
  },
  "homepage": "https://github.com/socratic-irony/zotero-snowball#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "bash scripts/build.sh",
    "validate:xpi": "bash scripts/validate-xpi.sh",
    "validate:manifest": "python3 -m json.tool src/manifest.json > /dev/null && xmllint --noout src/chrome/content/snowballDialog.xhtml && xmllint --noout src/chrome/content/snowballPrefs.xhtml && xmllint --noout src/chrome/content/snowballSettingsPane.xhtml",
    "bump": "bash scripts/bump-version.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run validate:manifest",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.14.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
